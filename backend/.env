# Optional: Specify Gemini model (default: gemini-2.5-flash)
# Available models: gemini-2.5-flash, gemini-2.5-pro, gemini-3-flash-preview
# GEMINI_MODEL=gemini-2.5-flash
# Optional: Specify API version (default: v1)
# GEMINI_API_VERSION=v1

# Hugging Face API Key (free AI service)
# IMPORTANT: Hugging Face changed their API endpoints and the old ones are deprecated
# The new router endpoint requires different authentication or paid plans
# Get your key from: https://huggingface.co/settings/tokens
# HUGGINGFACE_API_KEY=your-huggingface-key-here

# Ollama local AI (completely free, no API key needed)
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434

# Email Configuration for verification codes
# Option 1: SendGrid (Recommended for production - works great with Render)
# Get your API key from: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=your-sendgrid-api-key-here
SENDGRID_FROM_EMAIL=Mery Rose <noreply@meryrose.me>

# Option 2: Gmail SMTP (Alternative - may have connection issues on Render)
# For Gmail: Enable 2FA and generate app password at https://myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-gmail-app-password
EMAIL_FROM=Mery Rose <your-email@gmail.com>

# SMS/WhatsApp Configuration (Optional - requires Twilio account)
# Get credentials from: https://www.twilio.com/console
# TWILIO_ACCOUNT_SID=your-account-sid
# TWILIO_AUTH_TOKEN=your-auth-token
# TWILIO_PHONE_NUMBER=+1234567890
# TWILIO_WHATSAPP_NUMBER=+1234567890