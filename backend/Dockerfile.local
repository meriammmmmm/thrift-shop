# Backend image for local Docker (Debian base so the database drivers install cleanly)
FROM node:20-bookworm-slim

WORKDIR /app

# Build tools so any native module compiles if a prebuilt binary isn't found
RUN apt-get update \
  && apt-get install -y --no-install-recommends python3 make g++ ca-certificates \
  && rm -rf /var/lib/apt/lists/*

# Install dependencies
COPY package*.json ./
RUN npm install --omit=dev

# Copy the backend source
COPY . .

ENV PORT=5001
EXPOSE 5001

CMD ["npm", "start"]
