let selectedPrimaryColor = '#0d9488';
let selectedAccentColor = '#0d9488';
let customThemeName = 'Custom Theme';

// Select theme function
function selectTheme(themeName) {
    selectedTheme = themeName;
    selectedTheme = themeName;
    
    // Update UI to show selected theme
    document.querySelectorAll('.theme-option').forEach(option => {
        option.classList.remove('border-blue-500', 'bg-blue-50');
        option.classList.add('border-gray-200');
    });
    
    const selectedOption = document.querySelector(`[data-theme="${themeName}"]`);
    if (selectedOption) {
        selectedOption.classList.remove('border-gray-200');
        selectedOption.classList.add('border-blue-500', 'bg-blue-50');
    }
    
    // Update preview
    updateThemePreview(themeName);
    
    // Apply live preview to admin panel (temporary, not saved)
    const previewTheme = themeColors[themeName];
    if (previewTheme) {
        applyThemeToAdminPanel(previewTheme);
    }
}

// Select color from palette
function selectColor(colorHex, colorName, isAccent = false) {
    if (isAccent) {
        selectedAccentColor = colorHex;
        const accentElement = document.getElementById('selected-accent-color');
        const accentNameElement = document.getElementById('accent-color-name');
        if (accentElement) accentElement.style.backgroundColor = colorHex;
        if (accentNameElement) accentNameElement.textContent = colorName;
    } else {
        selectedPrimaryColor = colorHex;
        const primaryElement = document.getElementById('selected-primary-color');
        const primaryNameElement = document.getElementById('primary-color-name');
        if (primaryElement) primaryElement.style.backgroundColor = colorHex;
        if (primaryNameElement) primaryNameElement.textContent = colorName;
    }
    
    // Update custom theme preview automatically
    updateCustomThemePreview();
}

// Update custom theme preview
function updateCustomThemePreview() {
    const preview = document.getElementById('custom-theme-preview');
    if (preview) {
        preview.innerHTML = `
            <div class="flex items-center space-x-4 p-4 rounded-lg border" style="border-color: ${selectedPrimaryColor}">
                <div class="w-12 h-12 rounded-full" style="background-color: ${selectedPrimaryColor}"></div>
                <div>
                    <h4 class="font-medium" style="color: ${selectedPrimaryColor}">${customThemeName}</h4>
                    <p class="text-sm text-gray-600">Primary: ${selectedPrimaryColor}</p>
                </div>
                <button class="px-4 py-2 rounded text-white text-sm" style="background-color: ${selectedPrimaryColor}">
                    Preview Button
                </button>
            </div>
        `;
    }
    
    // Also apply temporary preview to admin panel
    const customTheme = {
        primary: selectedPrimaryColor,
        primaryHover: adjustBrightness(selectedPrimaryColor, -20),
        primaryLight: adjustBrightness(selectedPrimaryColor, 40),
        secondary: '#64748b',
        accent: selectedPrimaryColor,
        background: '#ffffff',
        text: '#1f2937',
        textLight: '#6b7280',
        success: '#10b981',
        error: '#ef4444',
        warning: '#f59e0b',
        info: '#3b82f6'
    };
    
    applyThemeToAdminPanel(customTheme);
}

// Apply custom theme
// Apply custom theme - Using proxy to avoid CORS
async function applyCustomTheme() {
    const customTheme = {
        primary: selectedPrimaryColor,
        primaryHover: adjustBrightness(selectedPrimaryColor, -20),
        primaryLight: adjustBrightness(selectedPrimaryColor, 40),
        secondary: '#64748b',
        accent: selectedPrimaryColor, // Same as primary
        background: '#ffffff',
        text: '#1f2937',
        textLight: '#6b7280',
        success: '#10b981',
        error: '#ef4444',
        warning: '#f59e0b',
        info: '#3b82f6'
    };
    
    console.log('Applying custom theme:', customTheme);
    
    try {
        // Save custom theme to backend via proxy
        const response = await fetch(`${API_BASE_URL}/settings`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify({
                key: 'theme',
                value: customTheme
            })
        });

        console.log('Response status:', response.status);
        
        if (response.ok) {
            const responseData = await response.json();
            console.log('Theme saved successfully:', responseData);
            
            // Apply theme to admin panel immediately
            applyThemeToAdminPanel(customTheme);
            currentThemeData = customTheme;
            
            alert('Custom theme applied successfully! The changes are visible on both the admin panel and user website.');
            
            // Update the theme selection UI
            selectedTheme = 'custom';
            document.querySelectorAll('.theme-option').forEach(option => {
                option.classList.remove('border-blue-500', 'bg-blue-50');
                option.classList.add('border-gray-200');
            });
            
        } else {
            const errorData = await response.text();
            throw new Error(`Server returned ${response.status}: ${errorData}`);
        }
    } catch (error) {
        console.error('Error applying custom theme:', error);
        
        // Apply theme locally anyway
        applyThemeToAdminPanel(customTheme);
        currentThemeData = customTheme;
        
        alert(`⚠️ Theme applied locally but failed to save to backend.\n\nError: ${error.message}\n\nPlease make sure:\n1. Backend server is running on port 5000\n2. Admin panel is accessed via http://localhost:8080`);
    }
}

// Helper function to adjust color brightness
function adjustBrightness(hex, percent) {
    // Remove # if present
    hex = hex.replace('#', '');
    
    // Parse RGB
    const r = parseInt(hex.substr(0, 2), 16);
    const g = parseInt(hex.substr(2, 2), 16);
    const b = parseInt(hex.substr(4, 2), 16);
    
    // Adjust brightness
    const newR = Math.max(0, Math.min(255, r + (r * percent / 100)));
    const newG = Math.max(0, Math.min(255, g + (g * percent / 100)));
    const newB = Math.max(0, Math.min(255, b + (b * percent / 100)));
    
    // Convert back to hex
    return '#' + 
        Math.round(newR).toString(16).padStart(2, '0') +
        Math.round(newG).toString(16).padStart(2, '0') +
        Math.round(newB).toString(16).padStart(2, '0');
}

// Update theme preview
function updateThemePreview(themeName) {
    const colors = themeColors[themeName];
    
    // Update preview color swatches
    document.getElementById('preview-primary').style.backgroundColor = colors.primary;
    document.getElementById('preview-primary-hover').style.backgroundColor = colors.primaryHover;
    document.getElementById('preview-accent').style.backgroundColor = colors.accent;
    
    // Update preview button
    const previewButton = document.getElementById('preview-button');
    previewButton.style.backgroundColor = colors.primary;
    previewButton.onmouseover = () => previewButton.style.backgroundColor = colors.primaryHover;
    previewButton.onmouseout = () => previewButton.style.backgroundColor = colors.primary;
    
    // Update preview link
    const previewLink = document.getElementById('preview-link');
    previewLink.style.color = colors.primary;
    previewLink.onmouseover = () => previewLink.style.color = colors.primaryHover;
    previewLink.onmouseout = () => previewLink.style.color = colors.primary;
}

// Apply theme function
async function applyTheme() {
    if (!selectedTheme) {
        alert('Please select a theme first');
        return;
    }
    
    try {
        const themeData = themeColors[selectedTheme];
        
        const response = await fetch(`${API_BASE_URL}/settings/theme`, {
            method: 'PUT',
            headers: {
                'Content-Type': 'application/json',
                'Authorization': `Bearer ${authToken}`
            },
            body: JSON.stringify({ value: themeData })
        });
        
        if (response.ok) {
            currentThemeData = themeData;
            // Apply theme to admin panel immediately
            applyThemeToAdminPanel(themeData);
            alert('Theme applied successfully! The changes are visible on both the admin panel and user website.');
            loadCurrentTheme(); // Refresh current theme display
        } else {
            const error = await response.json();
            alert(`Error applying theme: ${error.error}`);
        }
    } catch (error) {
        console.error('Apply theme error:', error);
        alert('Failed to apply theme');
    }
}

// Reset theme to default
async function resetTheme() {
    if (confirm('Are you sure you want to reset to the default teal theme?')) {
        try {
            const defaultTheme = themeColors.teal;
            
            const response = await fetch(`${API_BASE_URL}/settings/theme`, {
                method: 'PUT',
                headers: {
                    'Content-Type': 'application/json',
                    'Authorization': `Bearer ${authToken}`
                },
                body: JSON.stringify({ value: defaultTheme })
            });
            
            if (response.ok) {
                selectedTheme = 'teal';
                currentThemeData = defaultTheme;
                // Apply theme to admin panel immediately
                applyThemeToAdminPanel(defaultTheme);
                selectTheme('teal');
                alert('Theme reset to default successfully!');
            } else {
                const error = await response.json();
                alert(`Error resetting theme: ${error.error}`);
            }
        } catch (error) {
            console.error('Reset theme error:', error);
            alert('Failed to reset theme');
        }
    }
}

// Load current theme from backend
async function loadCurrentTheme() {
    try {
        const response = await fetch(`${API_BASE_URL}/settings/theme`);
        
        if (response.ok) {
            const data = await response.json();
            currentThemeData = data.theme;
            
            // Find which theme matches the current colors
            let matchingTheme = 'teal'; // default
            for (const [themeName, colors] of Object.entries(themeColors)) {
                if (colors.primary === currentThemeData.primary) {
                    matchingTheme = themeName;
                    break;
                }
            }
            
            selectedTheme = matchingTheme;
            selectTheme(matchingTheme);
        }
    } catch (error) {
        console.error('Load current theme error:', error);
        // Use default theme if loading fails
        selectedTheme = 'teal';
        selectTheme('teal');
    }
}

// Initialize theme settings when theme section is shown
function initializeThemeSettings() {
    loadCurrentTheme();
}

